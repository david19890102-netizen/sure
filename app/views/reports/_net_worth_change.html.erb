<%# locals: (change:) %>
<div class="space-y-3">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-secondary"><%= t("reports.net_worth_change.hint") %></p>
    <%= render DS::SegmentedControl.new(aria_label: t("reports.net_worth_change.mode_aria"), class: "overflow-x-auto no-scrollbar") do |control| %>
      <% %w[percent amount].each do |choice| %>
        <% control.with_segment(
             t("reports.net_worth_change.modes.#{choice}"),
             active: change.mode == choice,
             href: reports_path(request.query_parameters.merge(net_worth_change: choice)),
             class: "whitespace-nowrap"
           ) %>
      <% end %>
    <% end %>
  </div>

  <% if change.baseline_missing? %>
    <p id="reports-net-worth-change-empty" class="text-sm text-secondary"><%= t("reports.net_worth_change.no_baseline") %></p>
  <% elsif (chart = change.chart) %>
    <div
      id="reportsNetWorthChangeChart"
      class="w-full h-56 sm:h-72 privacy-sensitive"
      data-controller="time-series-chart"
      data-time-series-chart-data-value="<%= chart.to_json %>"
      draggable="false"></div>
  <% else %>
    <p id="reports-net-worth-change-empty" class="text-sm text-secondary"><%= t("reports.net_worth_change.no_data") %></p>
  <% end %>
</div>
