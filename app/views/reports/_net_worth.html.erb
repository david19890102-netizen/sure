<%# locals: (net_worth_metrics:, change:, range:) %>
<div class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-sm text-secondary"><%= t("reports.net_worth.current_net_worth") %></p>
      <p class="text-3xl font-semibold tabular-nums break-words text-primary privacy-sensitive">
        <%= reports_money(net_worth_metrics[:current_net_worth]) %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= render DS::SegmentedControl.new(aria_label: t("reports.net_worth.chart_period")) do |control| %>
        <% %w[month year all].each do |choice| %>
          <% control.with_segment(t("reports.net_worth.chart_periods.#{choice}"), active: range == choice,
               href: reports_path(request.query_parameters.merge(net_worth_period: choice)), class: "whitespace-nowrap") %>
        <% end %>
      <% end %>
      <%= render DS::SegmentedControl.new(aria_label: t("reports.net_worth_change.mode_aria")) do |control| %>
        <% Reports::NetWorthChangeSeries::MODES.each do |choice| %>
          <% control.with_segment(t("reports.net_worth_change.modes.#{choice}"), active: change.mode == choice,
               href: reports_path(request.query_parameters.merge(net_worth_change: choice)), class: "whitespace-nowrap") %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if (summary = change.summary) %>
    <p class="flex flex-wrap items-baseline gap-2 text-sm text-secondary" data-testid="reports-net-worth-summary">
      <%= t("reports.net_worth.chart_changes.#{range}") %>
      <span class="font-semibold tabular-nums privacy-sensitive" style="color: <%= summary[:color] %>">
        <%= summary[:amount] %>
        <%= summary[:percent] %>
      </span>
    </p>
  <% end %>

  <% if change.baseline_missing? %>
    <p id="reports-net-worth-change-empty" class="text-sm text-secondary"><%= t("reports.net_worth_change.no_baseline") %></p>
  <% elsif (chart = change.chart) %>
    <div id="reportsNetWorthChart" class="w-full h-56 sm:h-72 privacy-sensitive"
         data-controller="time-series-chart" data-time-series-chart-locale-value="<%= I18n.locale %>"
         data-time-series-chart-data-value="<%= chart.to_json %>" draggable="false"></div>
  <% else %>
    <p id="reports-net-worth-change-empty" class="text-sm text-secondary"><%= t("reports.net_worth_change.no_data") %></p>
  <% end %>

  <%# Asset/Liability Breakdown %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Assets Summary %>
    <div class="bg-container-inset rounded-xl p-1 overflow-x-auto w-full flex flex-col">
      <div class="rounded-lg shadow-border-xs bg-container overflow-hidden">
      <table class="w-full">
        <thead class="bg-container-inset">
          <tr class="uppercase text-xs font-medium text-secondary">
            <th class="px-4 py-2 text-left font-medium"><%= t("reports.net_worth.total_assets") %></th>
            <th class="px-4 py-2 text-right font-medium"><span class="sr-only"><%= t("reports.transactions_breakdown.table.amount") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% net_worth_metrics[:asset_groups].each_with_index do |group, idx| %>
            <tr class="<%= idx < net_worth_metrics[:asset_groups].size - 1 ? "table-divider" : "" %>">
              <td class="py-3 px-4 lg:px-6 text-sm font-medium text-secondary"><%= group[:name] %></td>
              <td class="py-3 px-4 lg:px-6 text-sm font-medium text-right text-primary tabular-nums privacy-sensitive"><%= reports_money(group[:total]) %></td>
            </tr>
          <% end %>
          <% if net_worth_metrics[:asset_groups].empty? %>
            <tr>
              <td colspan="2" class="text-sm text-subdued py-3 px-4 lg:px-6"><%= t("reports.net_worth.no_assets") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    </div>

    <%# Liabilities Summary %>
    <div class="bg-container-inset rounded-xl p-1 overflow-x-auto w-full flex flex-col">
      <div class="rounded-lg shadow-border-xs bg-container overflow-hidden">
      <table class="w-full">
        <thead class="bg-container-inset">
          <tr class="uppercase text-xs font-medium text-secondary">
            <th class="px-4 py-2 text-left font-medium"><%= t("reports.net_worth.total_liabilities") %></th>
            <th class="px-4 py-2 text-right font-medium"><span class="sr-only"><%= t("reports.transactions_breakdown.table.amount") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% net_worth_metrics[:liability_groups].each_with_index do |group, idx| %>
            <tr class="<%= idx < net_worth_metrics[:liability_groups].size - 1 ? "table-divider" : "" %>">
              <td class="py-3 px-4 lg:px-6 text-sm font-medium text-secondary"><%= group[:name] %></td>
              <td class="py-3 px-4 lg:px-6 text-sm font-medium text-right text-primary tabular-nums privacy-sensitive"><%= reports_money(group[:total]) %></td>
            </tr>
          <% end %>
          <% if net_worth_metrics[:liability_groups].empty? %>
            <tr>
              <td colspan="2" class="text-sm text-subdued py-3 px-4 lg:px-6"><%= t("reports.net_worth.no_liabilities") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>
